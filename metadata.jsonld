  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "file_catalog",
      "name": "file_catalog",
      "description": "96 file-level records for 48 systems. File paths, sizes and checksums come from the Hugging Face API; sampling fields come from the manuscript. Records are embedded in this JSON-LD and require no HDF5 downloads.",
      "key": {
        "@id": "file_catalog/filename"
      },
      "field": [
        {
          "@type": "cr:Field",
          "@id": "file_catalog/pdb_id",
          "name": "pdb_id",
          "description": "PDB identifier of the simulated system; does not imply that the simulation input is identical to the deposited structure.",
          "dataType": "sc:Text"
        },
        {
          "@type": "cr:Field",
          "@id": "file_catalog/filename",
          "name": "filename",
          "description": "Filename",
          "dataType": "sc:Text"
        },
        {
          "@type": "cr:Field",
          "@id": "file_catalog/file_kind",
          "name": "file_kind",
          "description": "File kind",
          "dataType": "sc:Text"
        },
        {
          "@type": "cr:Field",
          "@id": "file_catalog/size_bytes",
          "name": "size_bytes",
          "description": "File size in bytes reported by the repository API.",
          "dataType": "sc:Integer"
        },
        {
          "@type": "cr:Field",
          "@id": "file_catalog/sha256",
          "name": "sha256",
          "description": "SHA-256 checksum reported by the Hugging Face LFS API, not recomputed from HDF5 bytes.",
          "dataType": "sc:Text"
        },
        {
          "@type": "cr:Field",
          "@id": "file_catalog/download_url",
          "name": "download_url",
          "description": "Immutable Hugging Face URL pinned to the repository revision. Stored as text; reading this catalogue does not dereference it.",
          "dataType": "sc:Text"
        },
        {
          "@type": "cr:Field",
          "@id": "file_catalog/frame_stride_ps",
          "name": "frame_stride_ps",
          "description": "Documented output interval in picoseconds.",
          "dataType": "sc:Integer"
        },
        {
          "@type": "cr:Field",
          "@id": "file_catalog/states_in_file",
          "name": "states_in_file",
          "description": "Documented number of stored REST2 states.",
          "dataType": "sc:Integer"
        },
        {
          "@type": "cr:Field",
          "@id": "file_catalog/temperature_min_K",
          "name": "temperature_min_K",
          "description": "Minimum documented effective temperature in kelvin.",
          "dataType": "sc:Integer"
        },
        {
          "@type": "cr:Field",
          "@id": "file_catalog/temperature_max_K",
          "name": "temperature_max_K",
          "description": "Maximum documented effective temperature in kelvin.",
          "dataType": "sc:Integer"
        },
        {
          "@type": "cr:Field",
          "@id": "file_catalog/description",
          "name": "description",
          "description": "Description",
          "dataType": "sc:Text"

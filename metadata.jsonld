  "@type": "sc:Dataset",
  "name": "mdRNAcat",
  "description": "An all-atom molecular-dynamics catalogue of 48 RNA systems sampled with replica exchange with solute scaling (REST2). Each system uses 32 Hamiltonian states spanning effective temperatures of 300–500 K, with production lengths of 200–300 ns per state. Reference-state trajectories are provided at 1 ps intervals; all-state files use 100 ps intervals and additionally provide reference-Hamiltonian forces, structural observables and exchange metadata. This Croissant description provides an inline, download-free file catalogue and a manuscript-derived HDF5 data dictionary. It does not define native HDF5 tensor extraction or supply coordinate/force values. Higher-state configurations with reevaluated forces are not automatically distributed according to the reference-state equilibrium ensemble.",
  "url": "https://huggingface.co/datasets/anonymous8576/mdrnacat",
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "creator": {
    "@type": "sc:Organization",
    "name": "Anonymous dataset contributors"
  },
  "dateCreated": "2026-09-18T15:13:48.000Z",
  "dateModified": "2026-09-25T15:36:34.000Z",
  "identifier": "https://huggingface.co/datasets/anonymous8576/mdrnacat/tree/0647df6250e10f9b86d531a446a4e891e619baf8",
  "citeAs": "Anonymous dataset contributors. mdRNAcat: A Molecular Dynamics RNA Catalog of REST2 Conformational Ensembles. Anonymous review release. https://huggingface.co/datasets/anonymous8576/mdrnacat",
  "isLiveDataset": false,
  "keywords": [
    "RNA",
    "molecular dynamics",
    "REST2",
    "enhanced sampling",
    "atomic forces",
    "HDF5"
  ],
